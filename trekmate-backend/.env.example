# Configure this JDBC URL for the database selected by the active profile.
# Production example: jdbc:postgresql://postgres:5432/trekmate
DB_URL=jdbc:postgresql://postgres:5432/trekmate
DB_USERNAME=trekmate
DB_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
OPENWEATHER_API_KEY=
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=http://localhost:5173
PORT=8080
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Production PostgreSQL uses DB_URL, DB_USERNAME, and DB_PASSWORD.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
